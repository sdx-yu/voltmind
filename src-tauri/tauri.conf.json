{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "笔不怠",
  "version": "2.1.0",
  "identifier": "com.bibudai.writer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/bibudai-server"],
    "resources": ["../dist/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  }
}
