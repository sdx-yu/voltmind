{
  "name": "bi-bu-dai",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ui:check": "node scripts/check-ui-foundation.mjs",
    "ui:quality": "node scripts/check-ui-quality.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "check": "npm run ui:check && npm run ui:quality && npm run typecheck && npm run test && npm run build && npm run e2e",
    "sidecar:build": "node scripts/fetch-node-runtime.mjs && node scripts/build-sidecar.mjs",
    "desktop:prepare": "npm run build && npm run sidecar:build",
    "desktop:dev": "npm run desktop:prepare && node scripts/run-tauri.mjs dev",
    "desktop:build": "npm run desktop:prepare && node scripts/run-tauri.mjs build --bundles app,dmg",
    "release:macos": "node scripts/g4/macos-release.mjs",
    "release:macos:preflight": "node scripts/g4/macos-release.mjs --preflight-only",
    "release:windows": "node scripts/g4/windows-release.mjs",
    "release:windows:preflight": "node scripts/g4/windows-release.mjs --preflight-only",
    "release:mobile:verify": "node scripts/g4/verify-mobile-matrix.mjs",
    "release:materials": "mkdir -p release && cyclonedx-npm --omit dev --output-file release/bom.cdx.json --spec-version 1.6 && license-checker --production --json --out release/third-party-licenses.json",
    "release:checksums": "node scripts/update-release-checksums.mjs",
    "release:readiness": "node scripts/check-release-readiness.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tiptap/extension-character-count": "^3.4.1",
    "@tiptap/extension-placeholder": "^3.4.1",
    "@tiptap/react": "^3.4.1",
    "@tiptap/starter-kit": "^3.4.1",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "docx": "^9.5.1",
    "express": "^5.1.0",
    "lucide-react": "^0.542.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yjs": "^13.6.32",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "license-checker": "^25.0.1",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
